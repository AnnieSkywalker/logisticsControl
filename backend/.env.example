JWT_SECRET=your-secret-key-change-in-production
PORT=3001

# Email админа — на него отправляется пароль при первом деплое и 2FA-коды
ADMIN_EMAIL=admin@example.ru
# Если не задан — пароль генерируется случайно и отправляется на ADMIN_EMAIL
ADMIN_PASSWORD=

# SMTP (например Яндекс.Почта)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Разрешённые origins через запятую, например:
# CORS_ORIGIN=https://logistics.example.ru,http://localhost:5173
# Если не задано — разрешены все origins (только для разработки)
CORS_ORIGIN=
# Ключ шифрования секретов в БД (AES-256). Обязателен в production.
ENCRYPTION_KEY=
