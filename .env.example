# Скопировать в .env в корне проекта: cp .env.example .env

# Домен сервера и путь к сертификатам Let's Encrypt
SERVER_NAME=logistics.example.ru
CERT_DIR=/etc/letsencrypt/live/logistics.example.ru

# Секрет JWT — обязательно сменить (можно сгенерировать: openssl rand -hex 32)
JWT_SECRET=

# Ключ шифрования секретов в БД (AES-256) — обязательно (openssl rand -hex 32)
ENCRYPTION_KEY=

# Разрешённые origins через запятую, напр. https://logistics.example.ru,http://localhost:5173
# Пусто = разрешены все (только для разработки)
CORS_ORIGIN=https://logistics.example.ru,http://localhost:5173,http://127.0.0.1:5173

# Email админа — на него при первом деплое приходит пароль и 2FA-коды
ADMIN_EMAIL=admin@example.ru
# Если не задан — пароль генерируется случайно и отправляется на ADMIN_EMAIL
ADMIN_PASSWORD=

# Отключить 2FA. По умолчанию выключена вне production (локальная разработка).
# В проде (NODE_ENV=production) 2FA включена. Оставить пустым/закомментированным.
# DISABLE_2FA=true

# Яндекс.Почта SMTP (для отправки пароля и 2FA-кодов)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
